<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>ai-sanitize</AssemblyName>
    <RootNamespace>Sanitization.Cli</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>..\Sanitization.App\Assets\Sanitization.ico</ApplicationIcon>
    <AssemblyTitle>ai-sanitize (headless Sanitization for AI agents)</AssemblyTitle>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sanitization.Core\Sanitization.Core.csproj" />
  </ItemGroup>
</Project>
